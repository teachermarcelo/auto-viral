{
  "manifest_version": 3,
  "name": "AutoViral AI — Robot Assistido",
  "version": "0.4.4",
  "description": "Mapeia grupos públicos e prepara tarefas assistidas de campanha no AutoViral AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://nuyzvpkvawixidotuuio.supabase.co/*",
    "https://teachermarcelo.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://teachermarcelo.github.io/auto-viral/*"
      ],
      "js": [
        "platform-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/groups/*",
        "https://facebook.com/groups/*"
      ],
      "js": [
        "task-panel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AutoViral AI — Mapeador de Grupos",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
